# AI 서버 환경 변수 예시(.env는 커밋하지 않는다). PowerShell: $env:이름 = "값"
MODEL_BACKEND=llama
# 비교 프로필: 8b-q4(기본), 4b-q4, 4b-q8. 선생 후보: 14b-q4, 32b-q4(정의만). 실행·평가 명령에서 같은 값을 쓴다.
MODEL_PROFILE=8b-q4
MODEL_BASE_URL=http://127.0.0.1:8081/v1
MODEL_TIMEOUT_S=8
BUSY_WAIT_S=0.3
CANCEL_SETTLE_S=3
DEDUPE_TTL_S=30
MAX_TEXT_CHARS=400
# 백엔드 연동: 백엔드와 공유하는 내부 토큰(헤더 X-Internal-Token). 비우면 검사 안 함
AI_INTERNAL_TOKEN=
# 개발·평가 전용: 1이면 검사에 걸린 원문과 모델 출력을 logs/ai.err.log에 남긴다. 실제 사용·시연에서는 0
# 개발·평가 전용: 켜면 실패·성공 시도 출력 모두 서버 로그에 기록(앱 응답에는 포함하지 않음)
LOG_REJECTED=0

# 실행별 어댑터(기본은 빈 값). 변환기의 .gguf.json도 같은 위치에 필요
LORA_ADAPTER=
