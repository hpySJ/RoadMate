      "CancelRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "title": "Session Id"
          },
          "session_epoch": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Session Epoch"
          }
        },
        "additionalProperties": false,
        "type": "object",
